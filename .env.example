# Public base URL of the app (used for the fixed GitHub OAuth redirect URI)
APP_URL=http://localhost:3000

# GitHub OAuth (OAuth App or GitHub App user authorization)
# Callback URL to register on GitHub: ${APP_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated handles that can open /ops (moderation)
ADMIN_HANDLES=

# Allow "dev login" (pick a handle, no GitHub). Always on in `npm run dev`.
ALLOW_DEV_LOGIN=0

# PostgreSQL connection string (e.g. Supabase: Project Settings → Database → Connection string).
# On Vercel use the "Transaction pooler" string (port 6543).
DATABASE_URL=postgres://ct:ct@localhost:5432/corner_table
# DATABASE_SSL=disable | no-verify   (default: TLS for remote hosts, none for localhost)

# Supabase root CA (PEM, PEM with literal \n, or base64). Required on Vercel + Supabase pooler.
# Supabase Dashboard -> Project Settings -> Database -> SSL Configuration -> Download certificate.
# When set, the DB server certificate is verified against this CA.
DATABASE_CA_CERT=

# Email notifications (optional). Without these the app works and simply sends no email.
# Resend: https://resend.com — EMAIL_FROM must use a domain you verified there, e.g. "Corner Table <hello@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=
# Optional: Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/digest when this is set.
CRON_SECRET=
