# Public base URL of the app (used for the fixed GitHub OAuth redirect URI)
APP_URL=http://localhost:3000

# GitHub OAuth (OAuth App or GitHub App user authorization)
# Callback URL to register on GitHub: ${APP_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated handles that can open /ops (moderation)
ADMIN_HANDLES=

# Allow "dev login" (pick a handle, no GitHub). Always on in `npm run dev`.
ALLOW_DEV_LOGIN=0

# SQLite file location (default: ./data/corner-table.db)
# DB_PATH=./data/corner-table.db
